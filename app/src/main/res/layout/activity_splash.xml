<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Círculos decorativos (translúcidos, parcialmente fuera de pantalla) -->
    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-90dp"
        android:layout_marginEnd="-90dp"
        android:background="@drawable/bg_circle_translucent" />

    <View
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-50dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/bg_circle_translucent" />

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="-70dp"
        android:layout_marginBottom="-130dp"
        android:background="@drawable/bg_circle_translucent" />

    <!-- Logo + nombre + eslogan -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_logo_tile"
            android:contentDescription="@string/cd_logo"
            android:padding="26dp"
            android:src="@drawable/ic_restaurant"
            android:tint="@color/surface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/app_name"
            android:textColor="@color/surface"
            android:textSize="44sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.15"
            android:text="@string/splash_tagline"
            android:textColor="@color/white_80"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Indicadores (puntos) -->
    <LinearLayout
        android:id="@+id/splashDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:paddingBottom="32dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dot" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dot" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_dot" />
    </LinearLayout>
</FrameLayout>
