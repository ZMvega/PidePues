<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/registerContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_gray"
            android:contentDescription="@string/cd_back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/register_title"
            android:textAppearance="@style/TextAppearance.PidePues.Headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/register_subtitle"
            android:textAppearance="@style/TextAppearance.PidePues.Subtitle" />

        <!-- Nombre completo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_full_name"
            android:textAppearance="@style/TextAppearance.PidePues.Label" />

        <EditText
            android:id="@+id/etFullName"
            style="@style/Widget.PidePues.EditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_full_name"
            android:importantForAutofill="no"
            android:inputType="textPersonName|textCapWords|textNoSuggestions" />

        <!-- Correo -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_email"
            android:textAppearance="@style/TextAppearance.PidePues.Label" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/Widget.PidePues.EditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_email"
            android:importantForAutofill="no"
            android:inputType="textEmailAddress" />

        <!-- Teléfono -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_phone"
            android:textAppearance="@style/TextAppearance.PidePues.Label" />

        <EditText
            android:id="@+id/etPhone"
            style="@style/Widget.PidePues.EditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_phone"
            android:importantForAutofill="no"
            android:inputType="phone" />

        <!-- Contraseña -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:text="@string/label_password"
            android:textAppearance="@style/TextAppearance.PidePues.Label" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/Widget.PidePues.EditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:hint="@string/hint_password_register"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <!-- Términos (el texto con enlaces se asigna en Kotlin con HtmlCompat) -->
        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="8dp"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- Deshabilitado hasta aceptar los términos (se ve salmón, como en el mockup) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.PidePues.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:enabled="false"
            android:text="@string/register_button" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_have_account"
                android:textAppearance="@style/TextAppearance.PidePues.Subtitle" />

            <TextView
                android:id="@+id/tvGoLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp"
                android:text="@string/register_login_link"
                android:textAppearance="@style/TextAppearance.PidePues.Link" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
